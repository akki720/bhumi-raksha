# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/bhumi_raksha

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Weather data source
# Open-Meteo requires NO api key and is used as the default real weather/rainfall/forecast source.
# If you have an OpenWeatherMap key, set WEATHER_PROVIDER=openweathermap and add OWM_API_KEY.
WEATHER_PROVIDER=open-meteo
OWM_API_KEY=

# Elevation / terrain data source (no key required)
ELEVATION_PROVIDER=open-elevation
# https://api.open-elevation.com/api/v1/lookup  (default)
# or https://api.opentopodata.org/v1/srtm90m (fallback, also free)

# Cache TTLs (in minutes)
WEATHER_CACHE_TTL_MIN=15
ELEVATION_CACHE_TTL_MIN=1440

# Risk engine thresholds (0-100 score)
RISK_THRESHOLD_MODERATE=40
RISK_THRESHOLD_HIGH=65
RISK_THRESHOLD_CRITICAL=85

# Nearby query radius (meters) used for /api/risk/nearby and /api/safe-places/nearby
NEARBY_RADIUS_METERS=5000
